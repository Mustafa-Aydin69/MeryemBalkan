{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.meryembalkan.com.tr" }
      ],
      "destination": "https://meryembalkan.com.tr/:path*",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-sessions",
      "schedule": "0 3 * * *"
    }
  ]
}
